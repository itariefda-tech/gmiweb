# IP Server atau Nama Domain
FTP_HOST=103.229.73.58
FTP_PORT=21

# Username cPanel Anda
FTP_USER=k6147419

# Password cPanel Anda (atau password akun FTP)
FTP_PASSWORD=masukkan_password_cpanel_disini

# Folder Tujuan di cPanel:
# - Untuk domain utama (groupmitraindonesia.co.id): /public_html
# - Untuk subdomain (gmi.groupmitraindonesia.co.id): /gmi.groupmitraindonesia.co.id
FTP_REMOTE_DIR=/gmi.groupmitraindonesia.co.id

# Mode Secure (false untuk standar FTP port 21, true untuk FTPS)
FTP_SECURE=false

